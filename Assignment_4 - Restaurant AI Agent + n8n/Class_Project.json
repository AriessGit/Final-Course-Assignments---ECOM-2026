        "fromEmail": "ariecold@gmail.com",
        "toEmail": "ariecold@gmail.com",
        "subject": "Reservation Confirm!",
        "html": "=<!DOCTYPE html>\n<html>\n<body style=\"margin:0; padding:0; background-color:#eef6f8; font-family:Arial, Helvetica, sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#eef6f8; padding:24px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 16px rgba(0,60,90,0.15);\">\n\n          <!-- כותרת עליונה -->\n          <tr>\n            <td style=\"background:linear-gradient(135deg,#0b4f6c 0%,#01baef 55%,#5dd9c1 100%); padding:40px 30px; text-align:center;\">\n              <div style=\"font-size:36px; margin-bottom:8px;\">🌊🐟🦐</div>\n              <h1 style=\"color:#ffffff; margin:0; font-size:26px; letter-spacing:1px;\">Tasty Sea – Seafood</h1>\n              <p style=\"color:#e6faff; margin:6px 0 0; font-size:14px;\">Fresh from the sea to your table</p>\n            </td>\n          </tr>\n\n          <!-- הודעת אישור -->\n          <tr>\n            <td style=\"padding:32px 30px 8px; text-align:center;\">\n              <div style=\"font-size:40px;\">✅</div>\n              <h2 style=\"color:#0b4f6c; margin:12px 0 4px;\">Your Reservation is Confirmed!</h2>\n              <p style=\"color:#4a5a60; font-size:15px; margin:0;\">\n                Hi {{ $('Webhook').item.json.body.customer_name }}, we're excited to host you at Tasty Sea.\n              </p>\n            </td>\n          </tr>\n\n          <!-- פרטי ההזמנה עם גופן מוגדל -->\n          <tr>\n            <td style=\"padding:24px 30px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f2fbfd; border:1px solid #d3eef3; border-radius:10px;\">\n                <tr>\n                  <td style=\"padding:18px 20px; border-bottom:1px solid #d3eef3;\">\n                    <span style=\"color:#0b4f6c; font-weight:bold; font-size:18px;\">📅 Date:</span>\n                    <span style=\"color:#333; float:right; font-weight:bold; font-size:18px;\">{{ $('Webhook').item.json.body.date }}</span>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:18px 20px; border-bottom:1px solid #d3eef3;\">\n                    <span style=\"color:#0b4f6c; font-weight:bold; font-size:18px;\">🕒 Time:</span>\n                    <span style=\"color:#333; float:right; font-weight:bold; font-size:18px;\">{{ $('Webhook').item.json.body.time }}</span>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:18px 20px;\">\n                    <span style=\"color:#0b4f6c; font-weight:bold; font-size:18px;\">👥 Guests:</span>\n                    <span style=\"color:#333; float:right; font-weight:bold; font-size:18px;\">{{ $('Webhook').item.json.body.number_of_guests }}</span>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- טקסט תחתון -->\n          <tr>\n            <td style=\"padding:0 30px 24px; text-align:center;\">\n              <p style=\"color:#6b7b80; font-size:13px; line-height:1.6;\">\n                Need to change or cancel your reservation? Just reply to our chatbot with your full name, date and time.\n              </p>\n            </td>\n          </tr>\n\n          <!-- פוטר לבן אחיד (עוקף לינקים אוטומטיים של דואר) -->\n          <tr>\n            <td style=\"background-color:#0b4f6c; padding:24px 30px; text-align:center;\">\n              <p style=\"color:#ffffff; font-size:14px; margin:0 0 6px; font-weight:bold;\">Tasty Sea – Seafood</p>\n              \n              <p style=\"margin:0 0 4px;\">\n                <a style=\"color:#ffffff; font-size:12px; text-decoration:none;\">364 Ben Yehuda, Tel-Aviv</a>\n              </p>\n              \n              <p style=\"margin:0 0 4px; font-size:12px; color:#ffffff;\">\n                <a href=\"tel:+972540000000\" style=\"color:#ffffff; text-decoration:none;\">+972-540000000</a> &nbsp;|&nbsp; \n                <a href=\"mailto:hello@tasty.sea.example.il\" style=\"color:#ffffff; text-decoration:none;\">hello@tasty.sea.example.il</a>\n              </p>\n              \n              <p style=\"margin:0;\">\n                <a href=\"http://www.tastysea.example.il\" target=\"_blank\" style=\"color:#ffffff; font-size:12px; text-decoration:none;\">www.tastysea.example.il</a>\n              </p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
