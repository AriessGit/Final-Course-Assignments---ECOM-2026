 #f3d9d6;\">\n                    <span style=\"color:#0b4f6c; font-weight:bold; font-size:18px;\">🆔 Booking ID:</span>\n                    <span style=\"color:#333; float:right; font-weight:bold; font-size:18px;\">#{{ $('Webhook').item.json.body.id }}</span>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:18px 20px; border-bottom:1px solid #f3d9d6;\">\n                    <span style=\"color:#0b4f6c; font-weight:bold; font-size:18px;\">📅 Date:</span>\n                    <span style=\"color:#333; float:right; font-weight:bold; font-size:18px; text-decoration:line-through;\">\n                      {{ $('Webhook').item.json.body.date }}\n                    </span>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:18px 20px; border-bottom:1px solid #f3d9d6;\">\n                    <span style=\"color:#0b4f6c; font-weight:bold; font-size:18px;\">🕒 Time:</span>\n                    <span style=\"color:#333; float:right; font-weight:bold; font-size:18px; text-decoration:line-through;\">\n                      {{ $('Webhook').item.json.body.time }}\n                    </span>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:18px 20px;\">\n                    <span style=\"color:#0b4f6c; font-weight:bold; font-size:18px;\">👥 Guests:</span>\n                    <span style=\"color:#333; float:right; font-weight:bold; font-size:18px; text-decoration:line-through;\">\n                      {{ $('Webhook').item.json.body.number_of_guests }}\n                    </span>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- טקסט תחתון -->\n          <tr>\n            <td style=\"padding:0 30px 24px; text-align:center;\">\n              <p style=\"color:#6b7b80; font-size:13px; line-height:1.6;\">\n                Changed your mind? We'd love to have you at Tasty Sea — just message our chatbot to book a new time.\n              </p>\n            </td>\n          </tr>\n\n          <!-- פוטר לבן אחיד -->\n          <tr>\n            <td style=\"background-color:#0b4f6c; padding:24px 30px; text-align:center;\">\n              <p style=\"color:#ffffff; font-size:14px; margin:0 0 6px; font-weight:bold;\">Tasty Sea – Seafood</p>\n\n              <p style=\"margin:0 0 4px;\">\n                <a style=\"color:#ffffff; font-size:12px; text-decoration:none;\">364 Ben Yehuda, Tel-Aviv</a>\n              </p>\n\n              <p style=\"margin:0 0 4px; font-size:12px; color:#ffffff;\">\n                <a href=\"tel:+972540000000\" style=\"color:#ffffff; text-decoration:none;\">+972-540000000</a> &nbsp;|&nbsp;\n                <a href=\"mailto:hello@tasty.sea.example.il\" style=\"color:#ffffff; text-decoration:none;\">hello@tasty.sea.example.il</a>\n              </p>\n\n              <p style=\"margin:0;\">\n                <a href=\"http://www.tastysea.example.il\" target=\"_blank\" style=\"color:#ffffff; font-size:12px; text-decoration:none;\">www.tastysea.example.il</a>\n              </p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
